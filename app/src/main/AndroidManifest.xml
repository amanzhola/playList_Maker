<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Разрешения для работы приложения -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

<!--    &lt;!&ndash; Android 13+ (полный доступ к библиотеке) &ndash;&gt;-->
<!--    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />-->
<!--    &lt;!&ndash; Android 14+ (частичный доступ — только выбранные пользователем фото/видео) &ndash;&gt;-->
<!--    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />-->

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>

    <!--
         =========================
         option 0: icon [icon_launcher] and roundIcon [icon_launcher_round]
         option 1: icon [heart_launcher] and roundIcon [heart_launcher_round]
         option 2: icon [heart] and roundIcon [heart_round]
             =========================
        -->
    <application
        android:name=".App"
        android:allowBackup="true"
        android:icon="@mipmap/heart"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/heart_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        tools:targetApi="31">
        <activity
            android:name=".roots.movie.MovieRootActivity"
            android:windowSoftInputMode="adjustNothing"
            android:exported="false" /> <!-- <activity -->

        <!--
         =========================
             Стартовая активность — MainActivity
             =========================
        -->
        <activity
            android:name=".roots.main.MainActivity"
            android:theme="@style/AppTheme"
            android:windowSoftInputMode="adjustNothing"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.launcher.LauncherActivity"
            android:theme="@style/AppTheme"
            android:exported="true"
            android:launchMode="singleTop">

            <!-- SHARE INTENT (текст) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- OPEN FILE (json) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/json" />
            </intent-filter>

            <!-- ========== НОВОЕ: ПОЛУЧИТЬ ЧЕРЕЗ "ПОДЕЛИТЬСЯ" ZIP/PLZ ========== -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- покрываем разные MIME, которые встречаются у отправителей -->
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-zip-compressed" />
                <!-- (если введёшь свой кастомный MIME — добавь сюда ещё одну строку) -->
                <!-- <data android:mimeType="application/vnd.playlistmaker.playlist" /> -->
            </intent-filter>

            <!-- ========== НОВОЕ: ОТКРЫТЬ ZIP/PLZ ИЗ ФАЙЛ-МЕНЕДЖЕРА/ЗАГРУЗОК ========== -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/octet-stream" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>

        </activity> <!-- Другие активности без LAUNCHER -->
        <activity
            android:name=".ui.launcherPosters.TrackDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.movie.moviePosters.MoviePager"
            android:exported="false" />
        <activity
            android:name=".ui.movie.moviePosters.MoviePagerList"
            android:exported="false" />
        <activity
            android:name=".ui.weather.SearchWeather"
            android:exported="false" />
        <activity
            android:name=".ui.movie.SearchMovie"
            android:windowSoftInputMode="adjustNothing"
            android:exported="false" />
        <activity
            android:name=".ui.launcherPosters.TrackPreviewActivity"
            android:exported="false" />
        <!-- FileProvider для доступа к файлам -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>