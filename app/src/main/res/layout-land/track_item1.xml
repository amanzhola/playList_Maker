<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/track_item1"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white_textColor">

    <!-- ЛЕВАЯ ПАНЕЛЬ: квадрат на всю высоту -->
    <FrameLayout
        android:id="@+id/poster_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/details_container"
        app:layout_constraintDimensionRatio="1:1">

        <!-- Картинка -->
        <ImageView
            android:id="@+id/track_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/placeholder"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder2" />

        <!-- Видео (скрыто по умолчанию) -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:controller_layout_id="@layout/exo_controller_timebar_only"
            app:show_buffering="when_playing"
            app:resize_mode="zoom" />

        <!-- АУДИО-ТАЙМБАР (ваши цвета и логика останутся) -->
        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/audio_timebar"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            app:played_color="@color/timebar_played"
            app:scrubber_color="@color/timebar_scrubber"
            app:buffered_color="@color/timebar_buffered"
            app:unplayed_color="@color/timebar_unplayed"
            tools:visibility="visible"
            tools:background="#2200FF00" />
    </FrameLayout>

    <!-- ПРАВАЯ ПАНЕЛЬ: всё остальное -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/details_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingStart="@dimen/Padding_16"
        android:paddingEnd="@dimen/Padding_16"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/poster_container"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Прокрутка содержимого на случай маленькой ширины -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/details_scroll"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Имя трека -->
                <TextView
                    android:id="@+id/track_name"
                    style="@style/Text22_400"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="Yesterday (Remastered 2009)" />

                <!-- Автор -->
                <TextView
                    android:id="@+id/track_author"
                    style="@style/Text14_400"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/author_margin_top"
                    tools:text="The Beatles ..." />

                <!-- Ряд с Add / Play / Favorite -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="@dimen/author_margin_button">

                    <ImageView
                        android:id="@+id/add_track"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/add_track"
                        android:src="@drawable/add_queue" />

                    <com.example.playlistmaker.ui.widgets.PlaybackButtonView
                        android:id="@+id/play_track"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="65dp"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:iconPlay="@drawable/play"
                        app:iconPause="@drawable/pause" />

                    <ImageView
                        android:id="@+id/favorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/add_favorite"
                        android:src="@drawable/favorite" />
                </LinearLayout>

                <!-- Текущее время -->
                <TextView
                    android:id="@+id/play_time"
                    style="@style/Text14"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/author_margin_top"
                    android:text="@string/set_time"
                    android:textColor="@color/textColor_white"
                    tools:text="0:30" />

                <!-- Длительность -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/duration_margin_top">

                    <TextView
                        android:id="@+id/duration"
                        style="@style/Text13_400"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/duration" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/track_duration"
                        style="@style/Text13_400_"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="5:35" />
                </LinearLayout>

                <!-- Альбом -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/album_margin_top">

                    <TextView
                        android:id="@+id/album"
                        style="@style/Text13_400"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/album" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/track_album"
                        style="@style/Text13_400_"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:gravity="end"
                        android:layout_weight="1"
                        tools:text="Yesterday (Remastered 2009) ..." />
                </LinearLayout>

                <!-- Год -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/album_margin_top">

                    <TextView
                        android:id="@+id/year"
                        style="@style/Text13_400"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/year" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/track_year"
                        style="@style/Text13_400_"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="1965" />
                </LinearLayout>

                <!-- Жанр -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/album_margin_top">

                    <TextView
                        android:id="@+id/genre"
                        style="@style/Text13_400"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/genre" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/track_genre"
                        style="@style/Text13_400_"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Rock" />
                </LinearLayout>

                <!-- Страна -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="@dimen/album_margin_top"
                    android:layout_marginBottom="@dimen/marginBottom_4">

                    <TextView
                        android:id="@+id/country"
                        style="@style/Text13_400"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/country" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/track_country"
                        style="@style/Text13_400_"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="Великобритания" />
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
