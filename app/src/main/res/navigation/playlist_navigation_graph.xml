<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playlist_navigation_graph"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.example.playlistmaker.ui.audio.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" />
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.playlistmaker.ui.settings.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/mediaLibraryFragment"
        android:name="com.example.playlistmaker.ui.media.MediaLibraryFragment"
        android:label="fragment_media_library"
        tools:layout="@layout/fragment_media_library" />
    <fragment
        android:id="@+id/fragmentFavouriteTracks2"
        android:name="com.example.playlistmaker.ui.mediaFragments.FragmentFavouriteTracks"
        android:label="fragment_favourite_tracks"
        tools:layout="@layout/fragment_favourite_tracks" />
    <fragment
        android:id="@+id/fragmentPlaylist"
        android:name="com.example.playlistmaker.ui.mediaFragments.FragmentPlaylist"
        android:label="fragment_playlist"
        tools:layout="@layout/fragment_playlist" />
    <fragment
        android:id="@+id/mainFragment"
        android:name="com.example.playlistmaker.ui.main.MainFragment"
        android:label="MainFragment" />
</navigation>