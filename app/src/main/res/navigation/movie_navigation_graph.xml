<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/movie_navigation_graph"
    app:startDestination="@id/detailsFragment">

    <!-- Главное меню -->
    <!-- Главный экран деталей -->
    <fragment
        android:id="@+id/detailsFragment"
        android:name="com.example.playlistmaker.ui.movie.movieDetails.DetailsFragment"
        android:label="Details">
        <argument
            android:name="movie_id"
            app:argType="string" />
        <argument
            android:name="poster_url"
            app:argType="string" />
    </fragment>

    <!-- Имена (исправили пакет на ui.*) -->
    <fragment
        android:id="@+id/namesFragment"
        android:name="com.example.playlistmaker.ui.movie.movieNames.NamesFragment"
        android:label="Names" />
    <fragment
        android:id="@+id/infoFragment"
        android:name="com.example.playlistmaker.ui.movie.movieNames.InfoFragment"
        android:label="Info" />

    <!-- Второстепенный экран -->
    <!-- Каст -->
    <fragment
        android:id="@+id/moviesCastFragment"
        android:name="com.example.playlistmaker.ui.movie.movieCast.MoviesCastFragment"
        android:label="Movies Cast">
        <argument
            android:name="movie_id"
            app:argType="string" />
    </fragment>

    <!-- Наш новый фрагмент Movies Data Base-->
    <!-- История -->
    <fragment
        android:id="@+id/historyFragment"
        android:name="com.example.playlistmaker.ui.movie.movieHistory.HistoryFragment"
        android:label="fragment_history"
        tools:layout="@layout/fragment_history" />

</navigation>