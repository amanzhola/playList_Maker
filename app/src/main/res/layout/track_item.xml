<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/Settings_Height_61"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/track_item"
    android:paddingVertical="@dimen/Drawable_padding_8">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/track_image"
        android:layout_width="@dimen/track_45"
        android:layout_height="@dimen/track_45"
        android:layout_marginStart="@dimen/track_13"
        android:layout_gravity="center_vertical"
        tools:src="@drawable/barsik"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:layout_gravity="center_vertical"
        android:layout_marginHorizontal="@dimen/Drawable_padding_8"
        android:orientation="vertical">

        <TextView
            android:id="@+id/track_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Smells Like Teen Spirit"
            android:includeFontPadding="true"
            style="@style/track_name"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start|center_vertical"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/track_author"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="Nirvana 123456789012345678901234567890123456789012345678901234567890123"

                android:ellipsize="end"
                android:maxLines="1"
                android:includeFontPadding="true"

                app:drawableEndCompat="@drawable/dot"
                style="@style/track_author"/>

            <TextView
                android:id="@+id/track_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="true"
                tools:text="5:01"
                style="@style/track_author"/>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/arrow_fw"
        android:layout_width="@dimen/arrow_back_24"
        android:layout_height="@dimen/arrow_back_24"
        android:layout_gravity="center_vertical"
        android:contentDescription="@string/agreement"
        android:src="@drawable/vector"
        android:layout_marginEnd="@dimen/Icon_12"
        style="@style/arrow_fw"/>

</LinearLayout>