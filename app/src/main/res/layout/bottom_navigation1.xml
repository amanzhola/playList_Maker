<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNavigationContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white_textColor">

    <!-- Линия сверху -->
    <View
        android:id="@+id/navigationLine"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:background="@color/switch_track_off_color" />

    <!-- Сами кнопки -->
    <LinearLayout
        android:id="@+id/bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <include layout="@layout/bottom_view" android:id="@+id/bottom1"/>
        <include layout="@layout/bottom_view" android:id="@+id/bottom2"/>
        <include layout="@layout/bottom_view" android:id="@+id/bottom3"/>
        <include layout="@layout/bottom_view" android:id="@+id/bottom4"/>
        <include layout="@layout/bottom_view" android:id="@+id/bottom5"/>
        <include layout="@layout/bottom_view" android:id="@+id/bottom6"/>
    </LinearLayout>
</LinearLayout>