<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- disabled -->
    <item android:state_enabled="false" android:color="@color/hintColor" />
    <!-- в фокусе всегда приоритетнее -->
    <item android:state_focused="true" android:color="@color/switch_thumb_on_color"/>
    <!-- заполнено (активировано), но не в фокусе -->
    <item android:state_activated="true" android:color="@color/switch_thumb_on_color"/>
    <!-- по умолчанию -->
    <item android:color="@color/hintColor"/>
</selector>
