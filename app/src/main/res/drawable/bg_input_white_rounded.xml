<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Основной фон -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/switch_track_on_color_textColor"/>
            <corners android:radius="8dp"/>
            <padding
                android:left="0dp"
                android:top="6dp"
                android:right="0dp"
                android:bottom="6dp"/>
        </shape>
    </item>

    <!-- Нижнее «подчёркивание» -->
    <item android:gravity="bottom">
        <shape android:shape="rectangle">
            <size android:height="1dp"/>
            <solid android:color="@color/backgroundDay1"/>
            <!-- если нужно, можно скруглить низ, чтобы совпадало -->
            <!-- <corners android:bottomLeftRadius="8dp" android:bottomRightRadius="8dp"/> -->
        </shape>
    </item>

</layer-list>
